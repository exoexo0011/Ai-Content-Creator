# NVIDIA NIM API key — used by the Pipeline tab to generate content via the
# OpenAI-compatible chat completions endpoint at
# https://integrate.api.nvidia.com/v1/chat/completions
#
# Model used: meta/llama-4-maverick-17b-128e-instruct
#
# WARNING (security): VITE_* vars are bundled into the client JS at build time
# and will be visible to anyone who inspects your hosted site. This is fine for
# local development. For any public deployment, replace the direct fetch in
# src/context/PipelineContext.jsx with a call to a small backend proxy
# (Vercel/Cloudflare/Lambda function) so the key stays on the server.
#
# Get a key at https://build.nvidia.com/explore/discover
VITE_NVIDIA_API_KEY=nvapi-your-key-here
